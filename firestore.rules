rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function admin(){return request.auth!=null&&exists(/databases/$(d)/documents/admins/$(request.auth.token.email));}
 function form(k,n){return request.resource.data.keys().hasOnly(k)&&request.resource.data.read==false&&request.resource.data.at==request.time&&request.resource.data.msg is string&&request.resource.data.msg.size()<=n&&request.resource.data.name is string&&request.resource.data.name.size()<=100;}
 match /admins/{e}{allow read:if request.auth!=null&&(request.auth.token.email==e||admin());allow write:if admin();}
 match /events/{i}{allow read:if resource.data.pub==true||admin();allow write:if admin();}
 match /settings/{i}{allow read:if true;allow write:if admin();}
 match /people/{i}{allow read:if resource.data.pub==true||admin();allow write:if admin();}
 match /posts/{i}{allow read:if resource.data.pub==true||admin();allow write:if admin();}
 match /feedback/{i}{allow read:if resource.data.ok==true||admin();
  allow create:if form(['name','rate','msg','read','at','ok'],1000)&&request.resource.data.ok==false&&request.resource.data.rate is int&&request.resource.data.rate>=1&&request.resource.data.rate<=5;
  allow update,delete:if admin();}
 match /messages/{i}{allow create:if form(['name','email','msg','read','at'],2000)&&request.resource.data.email is string&&request.resource.data.email.size()<=150;allow read,update,delete:if admin();}
 match /joins/{i}{allow create:if form(['name','email','msg','read','at'],2000)&&request.resource.data.email is string&&request.resource.data.email.size()<=150;allow read,update,delete:if admin();}
}}
